{
  "name": "GiduScan",
  "version": "1.0.3",
  "description": "GiDu Scan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "qrcode": "^1.5.3",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.scandoc.app",
    "productName": "GiDu Scan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "extraResources": [
      "key.pem",
      "cert.pem",
      {
        "from": "pwa-phone",
        "to": "pwa-phone"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://giduchat.up.railway.app/update/"
      }
    ],
    "win": {
      "icon": "favicon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GiDu Scan"
    }
  }
}
